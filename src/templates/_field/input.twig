{% import '_includes/forms' as forms %}

{{ hiddenInput(name ~ '[language]', value.language ?? '') }}
{{ hiddenInput(name ~ '[auto]', value.auto ? '1' : '') }}
{{ hiddenInput(name ~ '[hash]', value.hash ?? '') }}
{{ hiddenInput(name ~ '[detectedAt]', value.detectedAt ? value.detectedAt|atom : '') }}

{# Shows the page's language, detected or chosen, or blank when there's none. Searchable, as every language is listed.
   The blank value needs allowEmptyOption. #}
{{ forms.selectize({
    id: id,
    name: name ~ '[mode]',
    options: [{ label: '', value: '' }]|merge(languageOptions),
    value: value.language ?? '',
    selectizeOptions: { allowEmptyOption: true },
}) }}

<p class="light smalltext">
    {% if not sitePublic %}
        {{ 'This site is disabled or has no base URL, so its pages aren’t public and aren’t detected.'|t('ai-hreflang') }}
    {% elseif not value.auto %}
        {{ 'Chosen by an editor, so it isn’t detected when the page is saved. Choose the blank option to detect it again.'|t('ai-hreflang') }}
    {% elseif value.detectedAt and value.language %}
        {{ 'Detected as {language} {date}. Choosing another language overrides it.'|t('ai-hreflang', { language: value.languageName, date: value.detectedAt|datetime('short') }) }}
    {% elseif value.detectedAt %}
        {{ 'The language couldn’t be told {date}, so the site’s own hreflang is used.'|t('ai-hreflang', { date: value.detectedAt|datetime('short') }) }}
    {% else %}
        {{ 'Not detected yet, so the site’s own hreflang is used. It is detected after the page is saved, if it has at least {count, number} words.'|t('ai-hreflang', { count: minimumWords }) }}
    {% endif %}
    {{ 'hreflang:'|t('ai-hreflang') }} <code>{{ hreflang }}</code>
</p>
