{# Styles are in the UtilityAsset bundle. Only values from the data, such as a segment's width, are inline. #}

{# Coverage as a small progress ring followed by the value. The radius is 15.9155 so the circumference is 100 and the
   percentage drives stroke-dasharray directly. #}
{% macro coverageRing(coverage) %}
    {%- if coverage is null -%}
        <span class="light">—</span>
    {%- else -%}
        {%- set level = coverage >= 100 ? 100 : (coverage >= 90 ? 90 : (coverage >= 75 ? 75 : (coverage >= 50 ? 50 : 0))) -%}
        <span class="aih-ring aih-ring-{{ level }}">
            <svg viewBox="0 0 40 40" width="16" height="16" aria-hidden="true" focusable="false">
                <circle class="aih-ring-track" cx="20" cy="20" r="15.9155" fill="none" stroke-width="6"/>
                {%- if coverage > 0 %}
                <circle class="aih-ring-value" cx="20" cy="20" r="15.9155" fill="none" stroke-width="6"
                        stroke-dasharray="{{ coverage|round(1) }} 100" stroke-linecap="round" transform="rotate(-90 20 20)"/>
                {%- endif %}
            </svg>
            {{ coverage|number_format(1) }}%
        </span>
    {%- endif -%}
{% endmacro %}

{# The share of a site's pages using each hreflang, as a stacked bar with a key below it. The site's own hreflang is
   grey, others are coloured by language (the same language is the same colour on every site) so pages served in
   another language stand out, and pages not detected yet are striped. #}
{% macro hreflangBar(hreflangs, siteHreflang, notDetected, languageColors, asText = false) %}
    {%- set total = hreflangs|reduce((sum, count) => sum + count, 0) + notDetected -%}
    {%- if total == 0 -%}
        <span class="light">—</span>
    {%- else -%}
        {%- set segments = [] -%}
        {%- for code, count in hreflangs|filter(count => count > 0) -%}
            {%- set language = code|split('-')|first|lower -%}
            {%- set segments = segments|merge([{
                label: code,
                code: not asText,
                count: count,
                class: code == siteHreflang ? 'aih-own' : (languageColors[language] is defined ? null : 'aih-other'),
                color: code != siteHreflang ? languageColors[language] ?? null : null,
            }]) -%}
        {%- endfor -%}
        {%- if notDetected > 0 -%}
            {%- set segments = segments|merge([{
                label: 'Not detected'|t('ai-hreflang'),
                code: false,
                count: notDetected,
                class: 'aih-not-detected',
                color: null,
            }]) -%}
        {%- endif -%}
        <div class="aih-bar">
            <div class="aih-bar-track" aria-hidden="true">
                {%- for segment in segments %}
                    <span class="{{ segment.class }}" style="width: {{ segment.count / total * 100 }}%;{{ segment.color ? " background: #{segment.color};" }}"></span>
                {%- endfor %}
            </div>
            <div class="aih-bar-key smalltext">
                {%- for segment in segments %}
                    <span class="aih-bar-key-item">
                        <span class="aih-swatch {{ segment.class }}"{% if segment.color %} style="background: {{ segment.color }};"{% endif %} aria-hidden="true"></span>
                        {% if segment.code %}<code>{{ segment.label }}</code>{% else %}{{ segment.label }}{% endif %} ({{ segment.count|number }})
                    </span>
                {%- endfor %}
            </div>
        </div>
    {%- endif -%}
{% endmacro %}

{# Detect missing (the usual action, so primary), Re-detect keeping the languages editors chose, and Re-detect all,
   which replaces those too, so it has Craft's caution style and asks first, saying how many pages it changes. #}
{% macro detectButtons(siteId, disabled, chosen) %}
    {% set actions = [
        {
            label: 'Detect missing'|t('ai-hreflang'),
            title: 'Detects pages that haven’t been, and pages whose text has changed since.'|t('ai-hreflang'),
            params: {},
            class: 'submit',
        },
        {
            label: 'Re-detect, keep chosen'|t('ai-hreflang'),
            title: 'Sends every page again, except pages whose language an editor chose.'|t('ai-hreflang'),
            params: { force: 1 },
            class: '',
        },
        {
            label: 'Re-detect all'|t('ai-hreflang'),
            title: 'Sends every page, and replaces the languages editors chose, putting those pages back to automatic.'|t('ai-hreflang'),
            params: { includeChosen: 1 },
            class: 'caution',
            confirm: chosen
            ? '{count, plural, =1{One page has a language an editor chose. Re-detect all replaces it with the detected language, and puts the page back to automatic.} other{# pages have a language an editor chose. Re-detect all replaces them with the detected languages, and puts the pages back to automatic.}} Continue?'|t('ai-hreflang', { count: chosen })
            : null },
    ] %}
    <div class="buttons aih-buttons">
        {% for action in actions %}
            <form method="post" accept-charset="UTF-8"
                  onsubmit="{% if action.confirm ?? null %}if (!confirm('{{ action.confirm|e('js') }}')) return false; {% endif %}this.querySelector('button').disabled = true">
                {{ csrfInput() }}
                {{ actionInput('ai-hreflang/utility/detect') }}
                {{ redirectInput('utilities/ai-hreflang') }}
                {{ siteId ? hiddenInput('siteId', siteId) }}
                {% for name, value in action.params %}
                    {{ hiddenInput(name, value) }}
                {% endfor %}
                <button type="submit" class="btn small {{ action.class }}" title="{{ action.title }}" {% if disabled %}disabled{% endif %}>
                    {{ action.label }}
                </button>
            </form>
        {% endfor %}
    </div>
{% endmacro %}

{% if currentUser.admin %}
    <div class="flex flex-nowrap aih-toolbar">
        <a href="{{ cpUrl('settings/plugins/ai-hreflang') }}" class="btn" data-icon="settings">{{ 'Plugin Settings'|t('ai-hreflang') }}</a>
    </div>
{% endif %}

{% if configurationError %}
    <p class="error">{{ configurationError }}</p>
{% endif %}

{% if not hasField %}
    <p class="warning with-icon">
        {{ 'The Content Language field isn’t in the field layout of any entries, categories or other elements with pages, so no pages are detected.'|t('ai-hreflang') }}
    </p>
{% endif %}

<div class="readable aih-intro">
    <p>
        {{ 'An hreflang tells search engines the language and region a page is for. Its value is a [BCP 47](https://www.rfc-editor.org/info/bcp47) language tag, `language-region`: a language subtag then a region subtag, written in the same format as each site’s language setting. Each site’s pages use the site’s language, such as `fr-FR` on the French site, until a page is detected in another language: a French site page still in English becomes `en-FR`.'|t('ai-hreflang')|md(inlineOnly=true) }}
    </p>
    <p>
        {{ 'Two copies of a page can’t share an hreflang. When a copy’s language would give it the same hreflang as another copy, such as an untranslated page on an `es-US` site next to the `en-US` site’s page, it keeps its site’s own hreflang, and the clash is shown below and in the page’s Content Language field.'|t('ai-hreflang')|md(inlineOnly=true) }}
    </p>
    {% if not configurationError %}
        <p class="light">
            {{ 'Languages are detected with the {provider} model {model}.'|t('ai-hreflang', { provider: provider, model: '`' ~ model ~ '`' })|md(inlineOnly=true) }}
        </p>
    {% endif %}
</div>

<details id="how-pages-are-detected" class="aih-how">
    <summary><strong>{{ 'How a page’s language is detected'|t('ai-hreflang') }}</strong></summary>
    <div class="readable">
        <ul class="bullets">
            <li>{{ 'When a page is saved, a queue job for each site the save changed runs after caches such as Blitz’s have been cleared, fetches the live page there, and sends its text to the AI provider, which replies with the language it is written in.'|t('ai-hreflang') }}</li>
            <li>{{ (contentSelector
                ? '**Read:** the text of the first element matching the [Content Selector]({url}), `{selector}`, or of the page’s `<body>` without its header and footer if none matches.'
                : '**Read:** the text of the page’s `<body>`, without its header and footer, as the [Content Selector]({url}) is blank.')|t('ai-hreflang', { selector: contentSelector, url: cpUrl('settings/plugins/ai-hreflang') })|md(inlineOnly=true) }}</li>
            <li>{{ '**Not read:** navigation, scripts, styles, SVGs, iframes, dialogs, form controls and hidden elements, and pages that aren’t live, such as disabled, pending and expired pages, which can’t be fetched. A pending page is detected once it is live and saved again, or detected from here.'|t('ai-hreflang')|md(inlineOnly=true) }}</li>
            <li>{{ 'Pages with fewer than {count, number} words aren’t sent, and keep their site’s own hreflang, as there isn’t enough text to tell their language reliably.'|t('ai-hreflang', { count: minimumWords }) }}</li>
            <li>{{ 'The first {count, number} characters are sent, with the whitespace collapsed, and the [prompt]({url}) asks for the language most of the text is written in. Language detection needs little text, and less text costs less. Changes after those characters don’t make a page count as changed.'|t('ai-hreflang', { count: maxCharacters, url: cpUrl('settings/plugins/ai-hreflang') })|md(inlineOnly=true) }}</li>
            <li>{{ 'A hash of the text, the provider, the model and the prompt is saved with the language, so a page isn’t sent again until one of them changes.'|t('ai-hreflang') }}</li>
            <li>{{ 'Pages whose language was chosen by an editor are skipped, unless you use **Re-detect all**. If the language couldn’t be detected, the page keeps its site’s own hreflang.'|t('ai-hreflang')|md(inlineOnly=true) }}</li>
        </ul>
    </div>
</details>

<h2>{{ 'Coverage'|t('ai-hreflang') }}</h2>

<p class="light">
    {{ '**Detect missing** detects pages that haven’t been, and pages whose text has changed since. **Re-detect, keep chosen** sends every page again, except pages whose language an editor chose. **Re-detect all** sends every page, and replaces the languages editors chose, putting those pages back to automatic. Pages are detected in the queue.'|t('ai-hreflang')|md(inlineOnly=true) }}
</p>

{% set totals = {
    total: stats|reduce((sum, row) => sum + row.total, 0),
    detected: stats|reduce((sum, row) => sum + row.detected, 0),
    undetermined: stats|reduce((sum, row) => sum + row.undetermined, 0),
    chosen: stats|reduce((sum, row) => sum + row.chosen, 0),
    clashes: stats|reduce((sum, row) => sum + row.clashes, 0),
} %}

{% macro notes(row) %}
    {% if row.undetermined %}
        <div class="light smalltext">{{ '{count, plural, =1{One page} other{# pages}} couldn’t be detected, so {count, plural, =1{it keeps} other{they keep}} the site’s hreflang.'|t('ai-hreflang', { count: row.undetermined }) }}</div>
    {% endif %}
    {% if row.chosen %}
        <div class="light smalltext">{{ '{count, plural, =1{One page has a language chosen by an editor, which is kept unless you use Re-detect all.} other{# pages have a language chosen by an editor, which are kept unless you use Re-detect all.}}'|t('ai-hreflang', { count: row.chosen }) }}</div>
    {% endif %}
    {% if row.clashes %}
        <div class="smalltext warning">{{ '{count, plural, =1{One page clashes} other{# pages clash}} with another site’s hreflang, so {count, plural, =1{it keeps} other{they keep}} the site’s own.'|t('ai-hreflang', { count: row.clashes }) }}</div>
    {% endif %}
{% endmacro %}

<div class="aih-scroll" tabindex="0" role="region" aria-label="{{ 'Content language coverage by site'|t('ai-hreflang') }}">
    <table class="data fullwidth">
        <thead>
            <tr>
                <th scope="col">{{ 'Site'|t('app') }}</th>
                <th scope="col">{{ 'Detected'|t('ai-hreflang') }}</th>
                <th scope="col">{{ 'Coverage'|t('ai-hreflang') }}</th>
                <th scope="col">{{ 'hreflang'|t('ai-hreflang') }}</th>
                <th scope="col">{{ 'Actions'|t('ai-hreflang') }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row"><strong>{{ 'All sites'|t('app') }}</strong></th>
                <td>{{ totals.detected|number }} / {{ totals.total|number }}</td>
                <td>{{ _self.coverageRing(totals.total ? totals.detected / totals.total * 100 : null) }}</td>
                <td>
                    {% set ownLanguage = stats|reduce((sum, row) => sum + (row.hreflangs[row.siteHreflang] ?? 0), 0) %}
                    {% set ownLabel = 'Site’s language'|t('ai-hreflang') %}
                    {{ _self.hreflangBar({
                        (ownLabel): ownLanguage,
                        ('Another language'|t('ai-hreflang')): totals.detected - ownLanguage,
                    }, ownLabel, totals.total - totals.detected, {}, true) }}
                    {{ _self.notes(totals) }}
                </td>
                <td>{{ _self.detectButtons(null, configurationError, totals.chosen) }}</td>
            </tr>
            {% for row in stats %}
                <tr>
                    <th scope="row">
                        {{ row.site.name }}
                        <div class="light smalltext"><code>{{ row.siteHreflang }}</code></div>
                    </th>
                    <td>{{ row.detected|number }} / {{ row.total|number }}</td>
                    <td>{{ _self.coverageRing(row.coverage) }}</td>
                    <td>
                        {{ _self.hreflangBar(row.hreflangs, row.siteHreflang, row.total - row.detected, languageColors) }}
                        {{ _self.notes(row) }}
                    </td>
                    <td>{{ _self.detectButtons(row.site.id, configurationError, row.chosen) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<hr>

<h2>{{ 'Pages in another language'|t('ai-hreflang') }}</h2>
<p class="light">
    {{ 'Pages written in a language other than their site’s on at least one site, with the hreflang each site gives them, most recently detected first. Highlighted values differ from the site’s own, faint ones haven’t been detected yet, and a warning marks a page that keeps its site’s hreflang because another site already uses the one it would have.'|t('ai-hreflang') }}
</p>

{% if otherLanguagePages %}
    <div class="aih-scroll" tabindex="0" role="region" aria-label="{{ 'Pages in another language'|t('ai-hreflang') }}">
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Page'|t('ai-hreflang') }}</th>
                    {% for site in sites %}
                        <th scope="col" title="{{ site.name }}">{{ site.language }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in otherLanguagePages %}
                    <tr>
                        <th scope="row">{{ elementChip(row.element, { hyperlink: true }) }}</th>
                        {% for site in sites %}
                            {% set cell = row.sites[site.id] ?? null %}
                            <td>
                                {% if cell %}
                                    <a href="{{ cell.element.cpEditUrl }}" title="{{ 'Edit on {site}'|t('ai-hreflang', { site: site.name }) }}">
                                        {%- if cell.other and not cell.clash -%}
                                            <span class="status-label orange aih-status-label"><span class="status orange"></span><span class="status-label-text">{{ cell.hreflang }}</span></span>
                                        {%- elseif cell.detected -%}
                                            <code>{{ cell.hreflang }}</code>
                                        {%- else -%}
                                            <code class="light aih-faint" title="{{ 'Not detected yet, so the site’s own hreflang is used'|t('ai-hreflang') }}">{{ cell.hreflang }}</code>
                                        {%- endif -%}
                                    </a>
                                    {% if cell.clash %}
                                        <div class="smalltext warning">{{ 'Would be {clash}, but {sites} already uses it'|t('ai-hreflang', { clash: cell.clash, sites: cell.clashSites|join(', ') }) }}</div>
                                    {% endif %}
                                    {% if cell.chosen %}<span class="light smalltext">{{ '(chosen)'|t('ai-hreflang') }}</span>{% endif %}
                                {% else %}
                                    <span class="light">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="aih-pagination">
        {% include '_includes/pagination' with { pageInfo: pageInfo, itemLabel: 'page'|t('ai-hreflang'), itemsLabel: 'pages'|t('ai-hreflang') } %}
    </div>
{% else %}
    <p>{{ 'None yet.'|t('ai-hreflang') }}</p>
{% endif %}
